@incollection{chapterBernard2024,
abstract = {Capacity planning may be defined as the process of determining the appropriate mix and quantity of resources to meet demand. We focus on Consolidation-based Freight Transportation and Logistics in this chapter, particularly on the planning of the supply capacity required to satisfy known or predicted, customer or internally-generated demand. It is noticeable that standard capacity formulations are based on a rough approximation of the physical and operational attributes of storage and movement capacity units and of how demand flows use that capacity. Bin Packing appears as a more appropriate methodology to address this issue and yet, few contributions in the literature focus on this topic is. Our objective is to start filling this gap in knowledge. The chapter recalls the main packing problems and models, identifies the main categories of stakeholders with their principal capacity requirements, reviews the relevant literature and proposes research avenues},
address = {Cham},
author = {Bruni, Maria Elena and Crainic, Teodor Gabriel and Perboli, Guido},
booktitle = {Combinatorial Optimization and Applications: A Tribute to Bernard Gendron},
doi = {10.1007/978-3-031-57603-4_6},
editor = {Crainic, Teodor Gabriel and Gendreau, Michel and Frangioni, Antonio},
isbn = {978-3-031-57603-4},
pages = {115--147},
publisher = {Springer Nature Switzerland},
title = {{Bin Packing Methodologies for Capacity Planning in Freight Transportation and Logistics}},
year = {2024}
}

@article{bruni2023machine,
abstract = {Third-party logistics is now an essential component of efficient delivery systems, enabling companies to purchase carrier services instead of an expensive fleet of vehicles. However, carrier contracts have to be booked in advance without exact knowledge of what orders will be available for dispatch. The model describing this problem is the variable cost and size bin packing problem with stochastic items. Since it cannot be solved for realistic instances by means of exact solvers, in this paper, we present a new heuristic algorithm able to do so based on machine learning techniques. Several numerical experiments show that the proposed heuristics achieve good performance in a short computational time, thus enabling its real-world usage. Moreover, the comparison against a new and efficient version of progressive hedging proves that the proposed heuristic achieves better results. Finally, we present managerial insights for a case study on parcel delivery in Turin, Italy.},
author = {Bruni, Maria Elena and Fadda, Edoardo and Fedorov, Stanislav and Perboli, Guido},
doi = {10.1016/J.COR.2023.106262},
journal = {Computers {\&} Operations Research},
keywords = {Capacity planning,Last-mile delivery,Machine learning,Metaheuristics,Third-party logistics,Variable cost and size bin packing},
pages = {106262},
publisher = {Pergamon},
title = {{A machine learning optimization approach for last-mile delivery and third-party logistics}},
volume = {157},
year = {2023}
}

